{
  "scenario_id": "AUTO-LONG-013",
  "metadata": {
    "domain": "ADAS",
    "sub_system": "Longitudinal Control",
    "target_feature": "False Activation Resistance (Steel Trench Plate)",
    "target_asil": "QM",
    "v_model_scope": ["SYS.2", "SYS.5"]
  },
  "regulatory_provenance": {
    "primary_source_doc": "final-rule-automatic-emergency-braking-systems-light-vehicles_web-version",
    "doc_number": 20,
    "specific_clause": "NHTSA FMVSS 127 Section III.F (False Activation Tests)",
    "benchmark_role": "Full Top-V Tier"
  },
  "input_context": {
    "user_intent": "The vehicle shall traverse over a secured 2.4m wide by 3.7m long and 25mm thick ASTM A36 steel trench plate lying flat in the middle of the travel lane at 80 km/h without initiating false emergency braking or generating peak additional deceleration greater than 0.25g.",
    "operational_design_domain": {
      "speed_range_kph": [75.0, 85.0],
      "road_type": "Straight flat asphalt containing ground-level construction steel plate",
      "environmental_conditions": "Daylight, dry road surface"
    },
    "interface_signals": {
      "input_signals": [
        {"name": "VehSpd_kph", "data_type": "float", "unit": "km/h", "valid_range": [0.0, 150.0]},
        {"name": "TargetClassification", "data_type": "enum", "unit": "enum", "valid_range": ["VEHICLE", "VRU", "ROAD_SURFACE_METALLIC", "UNKNOWN"]},
        {"name": "TrenchPlateDist_m", "data_type": "float", "unit": "m", "valid_range": [0.0, 100.0]}
      ],
      "output_signals": [
        {"name": "FCW_WarnState", "data_type": "enum", "unit": "enum", "valid_range": ["OFF", "STANDBY", "ACOUSTIC_OPTICAL"]},
        {"name": "AEB_DecelRequest_mps2", "data_type": "float", "unit": "m/s^2", "valid_range": [0.0, 9.81]}
      ]
    }
  },
  "ground_truth": {
    "decomposition_targets": [
      {
        "sub_intent_id": "SUB-FALSE-PLATE-01",
        "operational_mode": "False_Positive_Suppression",
        "description": "Classify ground-level metallic planar objects and suppress automatic braking commands"
      }
    ],
    "formal_requirements": [
      {
        "req_id": "REQ-SYS2-FALSE-001",
        "parent_sub_intent_id": "SUB-FALSE-PLATE-01",
        "statement": "When TargetClassification == ROAD_SURFACE_METALLIC and VehSpd_kph == 80.0 km/h, AEB_DecelRequest_mps2 shall not exceed 2.45 m/s^2 (0.25g additional deceleration) at any point prior to passing the plate.",
        "preconditions": "VehSpd_kph >= 75.0 and VehSpd_kph <= 85.0",
        "trigger": "TrenchPlateDist_m <= 40.0 and TargetClassification == ROAD_SURFACE_METALLIC",
        "postconditions": "AEB_DecelRequest_mps2 <= 2.45 and FCW_WarnState == OFF",
        "timing_ftti_ms": 50,
        "asil_rating": "QM"
      }
    ],
    "verification_test_cases": [
      {
        "test_id": "TC-SYS5-FALSE-001",
        "parent_req_id": "REQ-SYS2-FALSE-001",
        "test_category": "Nominal_Operational",
        "stimulus_vector": {
          "VehSpd_kph": 80.0,
          "TrenchPlateDist_m": 20.0,
          "TargetClassification": "ROAD_SURFACE_METALLIC"
        },
        "expected_assertions": "AEB_DecelRequest_mps2 <= 2.45 and FCW_WarnState == 'OFF'",
        "tolerances": { "max_peak_decel_mps2": 2.45 }
      }
    ]
  }
}