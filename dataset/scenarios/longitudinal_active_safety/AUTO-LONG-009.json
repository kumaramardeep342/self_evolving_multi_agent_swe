{
  "scenario_id": "AUTO-LONG-009",
  "metadata": {
    "domain": "ADAS",
    "sub_system": "Longitudinal Control",
    "target_feature": "AEB Car-to-Bicyclist Longitudinal Adult (CBLA-25)",
    "target_asil": "ASIL_C",
    "v_model_scope": ["SYS.2", "SYS.5"]
  },
  "regulatory_provenance": {
    "primary_source_doc": "C-NCAP_2024_Appendix_0_AEB_VRU_Pedestrain_TwoWheeler_Test",
    "doc_number": 9,
    "specific_clause": "C-NCAP 2024 Appendix O Section 0.6.2.7",
    "benchmark_role": "Full Top-V Tier"
  },
  "input_context": {
    "user_intent": "The vehicle shall detect an electric bicycle or bicyclist traveling longitudinally ahead in the same direction at 15 km/h at a 25% overlap, and autonomously apply emergency braking to avoid collision across vehicle speeds between 20 km/h and 60 km/h.",
    "operational_design_domain": {
      "speed_range_kph": [20.0, 60.0],
      "road_type": "Straight flat paved track, lane width >= 3.5 m, friction >= 0.9",
      "environmental_conditions": "Daylight, dry weather, no precipitation"
    },
    "interface_signals": {
      "input_signals": [
        {"name": "VehSpd_kph", "data_type": "float", "unit": "km/h", "valid_range": [0.0, 150.0]},
        {"name": "BikeTargetDist_m", "data_type": "float", "unit": "m", "valid_range": [0.0, 120.0]},
        {"name": "BikeTargetSpd_kph", "data_type": "float", "unit": "km/h", "valid_range": [0.0, 40.0]},
        {"name": "BikeOverlap_pct", "data_type": "float", "unit": "%", "valid_range": [-100.0, 100.0]}
      ],
      "output_signals": [
        {"name": "FCW_WarnState", "data_type": "enum", "unit": "enum", "valid_range": ["OFF", "STANDBY", "ACOUSTIC_OPTICAL"]},
        {"name": "AEB_DecelRequest_mps2", "data_type": "float", "unit": "m/s^2", "valid_range": [0.0, 9.81]}
      ]
    }
  },
  "ground_truth": {
    "decomposition_targets": [
      {
        "sub_intent_id": "SUB-CBLA-01",
        "operational_mode": "Bicyclist_Longitudinal_Braking",
        "description": "Trigger autonomous braking to match or drop below bicycle speed without impact"
      }
    ],
    "formal_requirements": [
      {
        "req_id": "REQ-SYS2-CBLA-001",
        "parent_sub_intent_id": "SUB-CBLA-01",
        "statement": "When VehSpd_kph is between 20.0 and 60.0 km/h and TTC <= 1.4 s relative to BikeTargetSpd_kph == 15.0 km/h at 25% overlap, AEB_DecelRequest_mps2 shall assert >= 5.5 m/s^2 within an FTTI of 60 ms.",
        "preconditions": "VehSpd_kph >= 20.0 and BikeOverlap_pct == 25.0",
        "trigger": "BikeTargetDist_m / ((VehSpd_kph - BikeTargetSpd_kph) / 3.6) <= 1.4",
        "postconditions": "AEB_DecelRequest_mps2 >= 5.5",
        "timing_ftti_ms": 60,
        "asil_rating": "ASIL_C"
      }
    ],
    "verification_test_cases": [
      {
        "test_id": "TC-SYS5-CBLA-001",
        "parent_req_id": "REQ-SYS2-CBLA-001",
        "test_category": "Nominal_Operational",
        "stimulus_vector": {
          "VehSpd_kph": 50.0,
          "BikeTargetDist_m": 13.5,
          "BikeTargetSpd_kph": 15.0,
          "BikeOverlap_pct": 25.0
        },
        "expected_assertions": "AEB_DecelRequest_mps2 >= 5.5",
        "tolerances": { "response_time_max_ms": 60 }
      }
    ]
  }
}