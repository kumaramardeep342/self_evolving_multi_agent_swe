{
  "scenario_id": "AUTO-LONG-005",
  "metadata": {
    "domain": "ADAS",
    "sub_system": "Longitudinal Control",
    "target_feature": "Dynamic Brake Support (DBS)",
    "target_asil": "ASIL_B",
    "v_model_scope": ["SYS.2", "SYS.5"]
  },
  "regulatory_provenance": {
    "primary_source_doc": "final-rule-automatic-emergency-braking-systems-light-vehicles_web-version",
    "doc_number": 20,
    "specific_clause": "NHTSA FMVSS 127 Section III.H.5 (Manual Brake Application)",
    "benchmark_role": "Full Top-V Tier"
  },
  "input_context": {
    "user_intent": "The vehicle shall supplement insufficient manual driver braking when approaching a lead vehicle at speeds between 70 km/h and 100 km/h. If the driver initiates braking with insufficient pedal force resulting in only 0.4g deceleration, the AEB system must automatically boost total deceleration to >= 0.7g to prevent collision.",
    "operational_design_domain": {
      "speed_range_kph": [70.0, 100.0],
      "road_type": "Straight dry asphalt, level slope, peak braking coefficient >= 0.9",
      "environmental_conditions": "Daylight, dry weather"
    },
    "interface_signals": {
      "input_signals": [
        {"name": "VehSpd_kph", "data_type": "float", "unit": "km/h", "valid_range": [0.0, 200.0]},
        {"name": "LeadTargetDist_m", "data_type": "float", "unit": "m", "valid_range": [0.0, 200.0]},
        {"name": "DriverBrakePedal_pct", "data_type": "float", "unit": "%", "valid_range": [0.0, 100.0]},
        {"name": "ManualBrakeDecel_mps2", "data_type": "float", "unit": "m/s^2", "valid_range": [0.0, 9.81]}
      ],
      "output_signals": [
        {"name": "AEB_DecelBoostRequest_mps2", "data_type": "float", "unit": "m/s^2", "valid_range": [0.0, 9.81]},
        {"name": "TotalEffectiveDecel_mps2", "data_type": "float", "unit": "m/s^2", "valid_range": [0.0, 9.81]}
      ]
    }
  },
  "ground_truth": {
    "decomposition_targets": [
      {
        "sub_intent_id": "SUB-DBS-01",
        "operational_mode": "Brake_Assist_Supplementation",
        "description": "Calculate shortfall in driver braking deceleration and command supplemental pressure"
      }
    ],
    "formal_requirements": [
      {
        "req_id": "REQ-SYS2-DBS-001",
        "parent_sub_intent_id": "SUB-DBS-01",
        "statement": "When VehSpd_kph is between 70.0 and 100.0 km/h and TTC <= 1.1 s with DriverBrakePedal_pct > 10.0% but ManualBrakeDecel_mps2 <= 3.92 m/s^2 (0.4g), AEB_DecelBoostRequest_mps2 shall assert supplemental braking such that TotalEffectiveDecel_mps2 >= 6.86 m/s^2 (0.7g) within 50 ms.",
        "preconditions": "VehSpd_kph >= 70.0 and DriverBrakePedal_pct >= 10.0",
        "trigger": "LeadTargetDist_m / (VehSpd_kph / 3.6) <= 1.1 and ManualBrakeDecel_mps2 <= 3.92",
        "postconditions": "TotalEffectiveDecel_mps2 >= 6.86",
        "timing_ftti_ms": 50,
        "asil_rating": "ASIL_B"
      }
    ],
    "verification_test_cases": [
      {
        "test_id": "TC-SYS5-DBS-001",
        "parent_req_id": "REQ-SYS2-DBS-001",
        "test_category": "Nominal_Operational",
        "stimulus_vector": {
          "VehSpd_kph": 80.0,
          "LeadTargetDist_m": 24.0,
          "DriverBrakePedal_pct": 25.0,
          "ManualBrakeDecel_mps2": 3.92
        },
        "expected_assertions": "TotalEffectiveDecel_mps2 >= 6.86",
        "tolerances": { "decel_tolerance_mps2": 0.2, "response_time_max_ms": 50 }
      }
    ]
  }
}