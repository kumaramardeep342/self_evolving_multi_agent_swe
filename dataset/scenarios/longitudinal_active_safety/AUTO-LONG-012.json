{
  "scenario_id": "AUTO-LONG-012",
  "metadata": {
    "domain": "ADAS",
    "sub_system": "Longitudinal Control",
    "target_feature": "AEB VRU Nighttime Darkness Avoidance (Low-Beam)",
    "target_asil": "ASIL_D",
    "v_model_scope": ["SYS.2", "SYS.5"]
  },
  "regulatory_provenance": {
    "primary_source_doc": "final-rule-automatic-emergency-braking-systems-light-vehicles_web-version",
    "doc_number": 20,
    "specific_clause": "NHTSA FMVSS 127 Section III.I.5 & Table 22",
    "benchmark_role": "Full Top-V Tier"
  },
  "input_context": {
    "user_intent": "The vehicle shall provide autonomous emergency braking to completely avoid colliding with a stationary pedestrian standing in the forward lane under dark nighttime conditions (ambient illumination <= 0.2 lux) using vehicle lower-beam headlamps only at speeds between 20 km/h and 55 km/h.",
    "operational_design_domain": {
      "speed_range_kph": [20.0, 55.0],
      "road_type": "Straight flat asphalt track, dry road, peak braking coefficient >= 0.9",
      "environmental_conditions": "Nighttime darkness, ambient illumination <= 0.2 lux, lower-beam headlamps active"
    },
    "interface_signals": {
      "input_signals": [
        {"name": "VehSpd_kph", "data_type": "float", "unit": "km/h", "valid_range": [0.0, 100.0]},
        {"name": "PedTargetDist_m", "data_type": "float", "unit": "m", "valid_range": [0.0, 80.0]},
        {"name": "AmbientIllumination_lux", "data_type": "float", "unit": "lux", "valid_range": [0.0, 100000.0]},
        {"name": "HeadlampBeamStatus", "data_type": "enum", "unit": "enum", "valid_range": ["OFF", "LOWER_BEAM", "UPPER_BEAM"]}
      ],
      "output_signals": [
        {"name": "FCW_WarnState", "data_type": "enum", "unit": "enum", "valid_range": ["OFF", "STANDBY", "ACOUSTIC_OPTICAL"]},
        {"name": "AEB_DecelRequest_mps2", "data_type": "float", "unit": "m/s^2", "valid_range": [0.0, 9.81]}
      ]
    }
  },
  "ground_truth": {
    "decomposition_targets": [
      {
        "sub_intent_id": "SUB-NIGHT-01",
        "operational_mode": "Low_Light_Pedestrian_Braking",
        "description": "Perceive pedestrian target under vehicle low-beam illumination and assert emergency stop"
      }
    ],
    "formal_requirements": [
      {
        "req_id": "REQ-SYS2-NIGHT-001",
        "parent_sub_intent_id": "SUB-NIGHT-01",
        "statement": "When VehSpd_kph is between 20.0 and 55.0 km/h, AmbientIllumination_lux <= 0.2, HeadlampBeamStatus == LOWER_BEAM, and TTC <= 1.2 s, AEB_DecelRequest_mps2 shall assert >= 6.5 m/s^2 within an FTTI of 50 ms.",
        "preconditions": "HeadlampBeamStatus == LOWER_BEAM and AmbientIllumination_lux <= 0.2",
        "trigger": "PedTargetDist_m / (VehSpd_kph / 3.6) <= 1.2",
        "postconditions": "AEB_DecelRequest_mps2 >= 6.5",
        "timing_ftti_ms": 50,
        "asil_rating": "ASIL_D"
      }
    ],
    "verification_test_cases": [
      {
        "test_id": "TC-SYS5-NIGHT-001",
        "parent_req_id": "REQ-SYS2-NIGHT-001",
        "test_category": "Boundary_Equivalence",
        "stimulus_vector": {
          "VehSpd_kph": 50.0,
          "PedTargetDist_m": 16.0,
          "AmbientIllumination_lux": 0.1,
          "HeadlampBeamStatus": "LOWER_BEAM"
        },
        "expected_assertions": "AEB_DecelRequest_mps2 >= 6.5",
        "tolerances": { "response_time_max_ms": 50 }
      }
    ]
  }
}