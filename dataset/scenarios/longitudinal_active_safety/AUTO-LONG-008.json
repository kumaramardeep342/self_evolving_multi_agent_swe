{
  "scenario_id": "AUTO-LONG-008",
  "metadata": {
    "domain": "ADAS",
    "sub_system": "Longitudinal Control",
    "target_feature": "AEB Pedestrian Crossing Farside Adult Obstructed (CPFAO-25)",
    "target_asil": "ASIL_C",
    "v_model_scope": ["SYS.2", "SYS.5"]
  },
  "regulatory_provenance": {
    "primary_source_doc": "C-NCAP_2024_Appendix_0_AEB_VRU_Pedestrain_TwoWheeler_Test",
    "doc_number": 9,
    "specific_clause": "C-NCAP 2024 Appendix O Section 0.6.1.8",
    "benchmark_role": "Full Top-V Tier"
  },
  "input_context": {
    "user_intent": "The vehicle shall provide autonomous emergency braking when an adult pedestrian traverses the roadway from the farside at 6.5 km/h, emerging from behind parked vehicles toward a 25% impact position, triggering warning and brake intervention across vehicle speeds between 20 km/h and 60 km/h.",
    "operational_design_domain": {
      "speed_range_kph": [20.0, 60.0],
      "road_type": "Straight paved road with farside obstruction vehicles",
      "environmental_conditions": "Daytime, ambient illumination > 2000 lux"
    },
    "interface_signals": {
      "input_signals": [
        {"name": "VehSpd_kph", "data_type": "float", "unit": "km/h", "valid_range": [0.0, 100.0]},
        {"name": "AdultTargetDist_m", "data_type": "float", "unit": "m", "valid_range": [0.0, 70.0]},
        {"name": "AdultLateralSpd_kph", "data_type": "float", "unit": "km/h", "valid_range": [0.0, 10.0]}
      ],
      "output_signals": [
        {"name": "FCW_WarnState", "data_type": "enum", "unit": "enum", "valid_range": ["OFF", "STANDBY", "ACOUSTIC_OPTICAL"]},
        {"name": "AEB_DecelRequest_mps2", "data_type": "float", "unit": "m/s^2", "valid_range": [0.0, 9.81]}
      ]
    }
  },
  "ground_truth": {
    "decomposition_targets": [
      {
        "sub_intent_id": "SUB-CPFAO-01",
        "operational_mode": "Farside_Crossing_Decel",
        "description": "Trigger emergency braking to avoid collision with fast-walking crossing pedestrian"
      }
    ],
    "formal_requirements": [
      {
        "req_id": "REQ-SYS2-CPFAO-001",
        "parent_sub_intent_id": "SUB-CPFAO-01",
        "statement": "When VehSpd_kph is between 20.0 and 60.0 km/h, AdultLateralSpd_kph == 6.5 km/h, and TTC <= 1.3 s, AEB_DecelRequest_mps2 shall assert >= 6.0 m/s^2 within an FTTI of 50 ms.",
        "preconditions": "VehSpd_kph >= 20.0 and VehSpd_kph <= 60.0",
        "trigger": "AdultTargetDist_m / (VehSpd_kph / 3.6) <= 1.3",
        "postconditions": "AEB_DecelRequest_mps2 >= 6.0",
        "timing_ftti_ms": 50,
        "asil_rating": "ASIL_C"
      }
    ],
    "verification_test_cases": [
      {
        "test_id": "TC-SYS5-CPFAO-001",
        "parent_req_id": "REQ-SYS2-CPFAO-001",
        "test_category": "Nominal_Operational",
        "stimulus_vector": {
          "VehSpd_kph": 40.0,
          "AdultTargetDist_m": 14.0,
          "AdultLateralSpd_kph": 6.5
        },
        "expected_assertions": "AEB_DecelRequest_mps2 >= 6.0",
        "tolerances": { "response_time_max_ms": 50 }
      }
    ]
  }
}