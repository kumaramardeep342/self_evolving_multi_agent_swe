{
  "scenario_id": "AUTO-LONG-006",
  "metadata": {
    "domain": "ADAS",
    "sub_system": "Longitudinal Control",
    "target_feature": "AEB Car-to-Pedestrian Longitudinal Adult (CPLA-25)",
    "target_asil": "ASIL_C",
    "v_model_scope": ["SYS.2", "SYS.5"]
  },
  "regulatory_provenance": {
    "primary_source_doc": "C-NCAP_2024_Appendix_0_AEB_VRU_Pedestrain_TwoWheeler_Test",
    "doc_number": 9,
    "specific_clause": "C-NCAP 2024 Appendix O Section 0.6.1.6",
    "benchmark_role": "Full Top-V Tier"
  },
  "input_context": {
    "user_intent": "The vehicle shall provide forward collision warning and autonomous emergency braking when an adult pedestrian is walking longitudinally in the same lane at 5 km/h with a 25% lateral overlap with the vehicle front, avoiding collision at vehicle speeds between 20 km/h and 40 km/h.",
    "operational_design_domain": {
      "speed_range_kph": [20.0, 40.0],
      "road_type": "Straight flat solid asphalt, friction coefficient >= 0.9",
      "environmental_conditions": "Daytime, natural illumination > 2000 lux, clear weather"
    },
    "interface_signals": {
      "input_signals": [
        {"name": "VehSpd_kph", "data_type": "float", "unit": "km/h", "valid_range": [0.0, 120.0]},
        {"name": "PedTargetDist_m", "data_type": "float", "unit": "m", "valid_range": [0.0, 100.0]},
        {"name": "PedTargetSpd_kph", "data_type": "float", "unit": "km/h", "valid_range": [0.0, 15.0]},
        {"name": "PedLateralOffset_pct", "data_type": "float", "unit": "%", "valid_range": [-100.0, 100.0]}
      ],
      "output_signals": [
        {"name": "FCW_WarnState", "data_type": "enum", "unit": "enum", "valid_range": ["OFF", "STANDBY", "ACOUSTIC_OPTICAL"]},
        {"name": "AEB_DecelRequest_mps2", "data_type": "float", "unit": "m/s^2", "valid_range": [0.0, 9.81]}
      ]
    }
  },
  "ground_truth": {
    "decomposition_targets": [
      {
        "sub_intent_id": "SUB-CPLA-01",
        "operational_mode": "Pedestrian_Longitudinal_Tracking",
        "description": "Recognize articulated pedestrian gait moving along vehicle corridor"
      },
      {
        "sub_intent_id": "SUB-CPLA-02",
        "operational_mode": "Emergency_Pedestrian_Braking",
        "description": "Execute autonomous full braking to completely avoid striking pedestrian at 25% overlap"
      }
    ],
    "formal_requirements": [
      {
        "req_id": "REQ-SYS2-CPLA-001",
        "parent_sub_intent_id": "SUB-CPLA-02",
        "statement": "When VehSpd_kph is between 20.0 and 40.0 km/h, PedTargetSpd_kph == 5.0 km/h, and TTC <= 1.2 s at 25% overlap, AEB_DecelRequest_mps2 shall assert >= 6.0 m/s^2 within an FTTI of 60 ms.",
        "preconditions": "VehSpd_kph >= 20.0 and PedLateralOffset_pct == 25.0",
        "trigger": "PedTargetDist_m / ((VehSpd_kph - PedTargetSpd_kph) / 3.6) <= 1.2",
        "postconditions": "AEB_DecelRequest_mps2 >= 6.0",
        "timing_ftti_ms": 60,
        "asil_rating": "ASIL_C"
      }
    ],
    "verification_test_cases": [
      {
        "test_id": "TC-SYS5-CPLA-001",
        "parent_req_id": "REQ-SYS2-CPLA-001",
        "test_category": "Nominal_Operational",
        "stimulus_vector": {
          "VehSpd_kph": 40.0,
          "PedTargetDist_m": 11.5,
          "PedTargetSpd_kph": 5.0,
          "PedLateralOffset_pct": 25.0
        },
        "expected_assertions": "AEB_DecelRequest_mps2 >= 6.0",
        "tolerances": { "response_time_max_ms": 60 }
      }
    ]
  }
}